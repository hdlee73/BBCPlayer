<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="38dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HD MP3_Player"
                android:textColor="@color/text_primary"
                android:textSize="23sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="3dp"
                android:text="(made by LHD)"
                android:textColor="@color/teal_600"
                android:textSize="10sp"
                android:textStyle="italic" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:id="@+id/fileName"
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:ellipsize="middle"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="오디오 파일을 선택하세요"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/timeText"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:text="00:00 / 00:00"
                android:textColor="@color/blue_400"
                android:textSize="12sp" />
            <com.example.bbcplayer.RepeatSeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:progressTint="@color/blue_500"
                android:thumbTint="@color/blue_400" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/backButton"
                    style="@style/CompactControlButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="−10초" />
                <Button
                    android:id="@+id/playButton"
                    style="@style/CompactPrimaryButton"
                    android:layout_width="0dp"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1.15"
                    android:text="재생" />
                <Button
                    android:id="@+id/forwardButton"
                    style="@style/CompactControlButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="+10초" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView style="@style/InlineLabel" android:layout_width="32dp" android:text="속도" />
                <Spinner
                    android:id="@+id/speedSpinner"
                    style="@style/DarkSpinner"
                    android:layout_width="68dp"
                    android:layout_marginStart="4dp"
                    android:dropDownWidth="88dp" />
                <Space android:layout_width="8dp" android:layout_height="1dp" />
                <TextView style="@style/InlineLabel" android:layout_width="32dp" android:text="이동" />
                <Spinner
                    android:id="@+id/seekStepSpinner"
                    style="@style/DarkSpinner"
                    android:layout_width="68dp"
                    android:layout_marginStart="4dp"
                    android:dropDownWidth="88dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="39dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView style="@style/SectionLabel" android:text="구간 반복" />
                <TextView
                    android:id="@+id/repeatStatus"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:text="꺼짐"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
                <Button android:id="@+id/aButton" style="@style/MiniButton" android:contentDescription="A 시작점" android:text="A〔" />
                <Button android:id="@+id/bButton" style="@style/MiniButton" android:layout_marginStart="4dp" android:contentDescription="B 종료점" android:text="〕B" />
                <Button android:id="@+id/clearRepeatButton" style="@style/MiniButton" android:layout_marginStart="4dp" android:contentDescription="구간 반복 해제" android:text="↻×" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView style="@style/SectionLabel" android:layout_width="60dp" android:text="즐겨찾기" />
                <TextView
                    android:id="@+id/bookmarkStatus"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
                <Button android:id="@+id/bookmark1Button" style="@style/MiniButton" android:layout_width="0dp" android:layout_weight="1" android:contentDescription="즐겨찾기 1, 길게 눌러 저장 또는 해제" android:text="1  --:--" android:textSize="9sp" />
                <Button android:id="@+id/bookmark2Button" style="@style/MiniButton" android:layout_width="0dp" android:layout_marginStart="4dp" android:layout_weight="1" android:contentDescription="즐겨찾기 2, 길게 눌러 저장 또는 해제" android:text="2  --:--" android:textSize="9sp" />
                <Button android:id="@+id/bookmark3Button" style="@style/MiniButton" android:layout_width="0dp" android:layout_marginStart="4dp" android:layout_weight="1" android:contentDescription="즐겨찾기 3, 길게 눌러 저장 또는 해제" android:text="3  --:--" android:textSize="9sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView style="@style/InlineLabel" android:layout_width="54dp" android:text="재생 반복" />
                <Spinner
                    android:id="@+id/repeatModeSpinner"
                    style="@style/DarkSpinner"
                    android:layout_width="72dp"
                    android:layout_marginStart="4dp"
                    android:dropDownWidth="92dp" />
                <Spinner
                    android:id="@+id/repeatCountSpinner"
                    style="@style/DarkSpinner"
                    android:layout_width="84dp"
                    android:layout_marginStart="4dp"
                    android:dropDownWidth="92dp" />
            </LinearLayout>
            <Button
                android:id="@+id/openButton"
                style="@style/CompactPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:text="오디오 파일 열기"
                android:textSize="14sp" />
            <Button
                android:id="@+id/bbcButton"
                style="@style/BbcLinkButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_gravity="end"
                android:text="BBC 최신 6 Minute English 받기  ›" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

