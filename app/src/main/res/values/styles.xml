<resources>
    <style name="Theme.BBCPlayer" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/navy_950</item>
        <item name="android:colorAccent">@color/blue_500</item>
        <item name="android:statusBarColor">@color/navy_950</item>
        <item name="android:navigationBarColor">@color/navy_950</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="CompactControlButton" parent="Widget.Material3.Button">
        <item name="android:layout_height">46dp</item>
        <item name="android:backgroundTint">@color/surface_border</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="insetTop">0dp</item>
        <item name="insetBottom">0dp</item>
    </style>
    <style name="CompactPrimaryButton" parent="CompactControlButton">
        <item name="android:backgroundTint">@color/blue_500</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="SecondaryButton" parent="CompactControlButton">
        <item name="android:backgroundTint">@color/mint_100</item>
        <item name="android:textColor">@color/teal_700</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="MiniButton" parent="CompactControlButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="InlineLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="SectionLabel" parent="InlineLabel">
        <item name="android:layout_width">68dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="DarkSpinner">
        <item name="android:layout_height">40dp</item>
        <item name="android:backgroundTint">@color/blue_400</item>
        <item name="android:popupBackground">@color/navy_800</item>
    </style>
    <style name="BbcLinkButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/blue_400</item>
        <item name="android:textSize">11sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="insetTop">0dp</item>
        <item name="insetBottom">0dp</item>
    </style>
</resources>

